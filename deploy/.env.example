# MarketMind — local deploy configuration.
#   cp deploy/.env.example deploy/.env   and fill in the values marked REQUIRED.
# Everything else has a working default. Read by `docker compose --env-file`
# and by deploy/bootstrap.sh; never committed (deploy/.env is git-ignored).

# ---------------------------------------------------------------- database --
# One Postgres, one database per service, one user for all of them.
POSTGRES_USER=marketmind
# REQUIRED
POSTGRES_PASSWORD=marketmind
POSTGRES_PORT=5440

# ------------------------------------------------------------- host ports --
# Where each service is published on this machine. Change any of them if the
# port is taken; the services find each other by name, not by these.
WEB_PORT=8080
ORCHESTRATOR_PORT=8081
SCORING_PORT=8004
PYTRENDS_PORT=8000
OECD_PORT=8001
UNDATA_PORT=8002
WORLDBANK_PORT=8003
OLLMA_PORT=8005

# Base URL the browser bundle uses for the API, fixed at image build time.
# "/api" is proxied by the web's nginx to the orchestrator (no CORS needed).
# Changing it means `make up` again (the image is rebuilt).
WEB_API_BASE=/api

# -------------------------------------------------------- shared secrets --
# Secret the orchestrator presents on the scoring's /internal/* routes
# (scoring: INTERNAL_API_TOKEN, orchestrator: SCORING_INTERNAL_TOKEN). Any
# long random string; empty refuses every internal call.
# REQUIRED
INTERNAL_API_TOKEN=

# Every LLM call site of the scoring, and the orchestrator's decisions, run on Claude.
# REQUIRED
ANTHROPIC_API_KEY=
# Only for an organisation-scoped key; leave empty otherwise.
ANTHROPIC_WORKSPACE_ID=
# Prompt cache lifetime for the system prompts: 1h or 5m.
LLM_PROMPT_CACHE_TTL=1h

# Catalog semantic search embeddings (Voyage AI). Without it the catalog still
# resolves by alias and trigram, but never by meaning.
# recommended
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4
VOYAGE_EMBEDDING_DIMENSIONS=1024
CATALOG_SEMANTIC_ABSTENTION_MARGIN=0.035
CATALOG_TRIGRAM_SIMILARITY_THRESHOLD=0.4

# OpenAI: embedding fallback of the catalog resolver, and any site whose
# *_LLM_PROVIDER is set to "gpt". Optional.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# DataForSEO, the demand source behind the pytrends collector. Sandbox: same
# auth, mock data, never billed. A real analysis needs false.
# REQUIRED
DATAFORSEO_LOGIN=
# REQUIRED (API password, not the account one)
DATAFORSEO_PASSWORD=
DATAFORSEO_USE_SANDBOX=false
DEFAULT_HL=en-US

# Model the orchestrator uses for its recovery decisions (same Anthropic key).
DECISION_MODEL=claude-sonnet-5-5

# Langfuse tracing (scoring + orchestrator write into one trace). Optional;
# unset means untraced.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=local

# ---------------------------------------------------------------- scoring --
APP_ENV=local
LOG_LEVEL=INFO
COLLECTION_POLL_INTERVAL_SECONDS=2.0
COLLECTION_POLL_TIMEOUT_SECONDS=120.0
COLLECTION_DISPATCH_TIMEOUT_SECONDS=1800.0

# Provider and model per call site. provider: claude | gpt | ollama
# ("ollama" goes through the ollma-llm gateway, profile local-llm).
VISION_LLM_PROVIDER=claude
VISION_LLM_MODEL=claude-sonnet-5-5
ENRICHMENT_LLM_PROVIDER=claude
ENRICHMENT_LLM_MODEL=claude-opus-5
REFERENCE_MARKET_LLM_PROVIDER=claude
REFERENCE_MARKET_LLM_MODEL=claude-opus-5
EXPLANATION_LLM_PROVIDER=claude
EXPLANATION_LLM_MODEL=claude-opus-5
CATALOG_MATCH_LLM_PROVIDER=claude
CATALOG_MATCH_LLM_MODEL=claude-opus-5

# ------------------------------------------------ ollma-llm (local-llm) --
# Ollama runs on the host; host.docker.internal is the host from a container.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_TIMEOUT=300
OLLAMA_NUM_CTX=32768
