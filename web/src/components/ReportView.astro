---
// Client-rendered report body. Both /report/[id] and /r/[slug] mount this and
// hydrate it from the Core by analysis request id. It polls GET /analyze/{id}
// until the background pipeline finishes, showing a live loader meanwhile, then
// renders the per-country MOS ranking and the LLM business narrative.
interface Props {
  /** Show the sticky action bar (hidden on the public share view). */
  showActions?: boolean;
  /** When true, resolve the id from a /r/{slug} URL (slug = uuid hex). */
  fromSlug?: boolean;
}
const { showActions = true, fromSlug = false } = Astro.props;
---

<div class="report-root" data-show-actions={showActions ? "1" : "0"} data-from-slug={fromSlug ? "1" : "0"}>
  <!-- loading / analyzing state -->
  <div id="r-state" class="r-state">
    <div class="eyebrow" data-i18n="an.eyebrow">Live analysis</div>
    <div class="anhead">
      <div class="pt product-thumb"></div>
      <div>
        <h2 class="product-title" id="an-title" data-i18n="an.title">Analyzing your product…</h2>
        <div class="meta mono" id="an-meta" data-i18n="an.meta">running the pipeline</div>
      </div>
    </div>
    <div class="barwrap"><div class="b" id="anbar"></div></div>
    <div class="steps" id="steps">
      <div class="st" data-res="…"><div class="dotc">✓</div><div class="sl" data-i18n="an.step1">Ensuring data freshness</div><div class="sd"></div></div>
      <div class="st" data-res="…"><div class="dotc">✓</div><div class="sl" data-i18n="an.step2">Collecting missing signals</div><div class="sd"></div></div>
      <div class="st" data-res="…"><div class="dotc">✓</div><div class="sl" data-i18n="an.step3">Computing Cap. 4 indicators</div><div class="sd"></div></div>
      <div class="st" data-res="…"><div class="dotc">✓</div><div class="sl" data-i18n="an.step4">Computing the MOS per country</div><div class="sd"></div></div>
      <div class="st" data-res="…"><div class="dotc">✓</div><div class="sl" data-i18n="an.step5">Writing the business narrative</div><div class="sd"></div></div>
    </div>
    <div id="an-error" class="an-error" style="display: none;"></div>
  </div>

  <div id="r-body" style="display: none;">
    <!-- header -->
    <div class="rephead">
      <div class="rl">
        <div class="rthumb product-thumb"></div>
        <div>
          <span class="chip" id="r-chip">opportunity</span>
          <h2 class="product-title" id="r-title">Product</h2>
          <div class="when mono" id="r-when"></div>
        </div>
      </div>
    </div>

    <!-- top-market scorecard -->
    <div class="scorecard">
      <div class="gauge">
        <svg width="148" height="148" viewBox="0 0 148 148">
          <circle cx="74" cy="74" r="63" fill="none" stroke="rgba(255,255,255,.07)" stroke-width="11"></circle>
          <circle id="r-ring" cx="74" cy="74" r="63" fill="none" stroke="url(#r-grad)" stroke-width="11"
            stroke-linecap="round" stroke-dasharray="396" stroke-dashoffset="396" transform="rotate(-90 74 74)"></circle>
          <defs>
            <linearGradient id="r-grad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#ecbc4e"></stop>
              <stop offset="1" stop-color="#5fd0ad"></stop>
            </linearGradient>
          </defs>
        </svg>
        <div class="val">
          <div class="num" id="r-num">0</div>
          <div class="den" data-i18n="rep.mos">MOS / 100</div>
        </div>
      </div>
      <div class="verdict">
        <div class="vt mono" id="r-vt" data-i18n="rep.topmarket">Top market</div>
        <h3 id="r-verdict">—</h3>
        <p id="r-summary"></p>
      </div>
    </div>

    <!-- ranking (relabelled to a single-market analysis when only one country) -->
    <div class="sec">
      <div class="sectitle" id="r-ranking-title" data-i18n="rep.ranking">Market Opportunity ranking</div>
      <div class="mkts" id="r-ranking"></div>
    </div>

    <!-- comparison table: MOS + every score across all countries -->
    <div class="sec" id="r-comparison-sec" style="display: none;">
      <div class="sectitle" data-i18n="rep.comparison">Comparison — MOS &amp; all scores</div>
      <div class="cmp-wrap"><table class="cmp" id="r-comparison"></table></div>
    </div>

    <!-- narrative -->
    <div class="sec" id="r-narrative-sec" style="display: none;">
      <div class="sectitle" data-i18n="rep.narrative">Analysis</div>
      <div class="narrative" id="r-narrative"></div>
      <!-- EU AI Act art. 50: say the text was written by a model, next to it. -->
      <p class="ai-notice" data-i18n="rep.aiNotice">Written by an AI language model from the figures above. The scores are calculated, not written by the model.</p>
    </div>

    <!-- action bar -->
    <div class="actions" id="r-actions" style="display: none;">
      <div class="lft mono" id="r-actions-summary"></div>
      <div class="grp">
        <button class="btn ghost" id="r-share" data-i18n="rep.copy">Copy share link</button>
        <a class="btn" href="/" data-i18n="rep.new">New analysis</a>
      </div>
    </div>
  </div>
</div>

<div class="toast" id="r-toast"><span class="ck">✓</span><span id="r-toast-msg"></span></div>

<style is:global>
  .r-state { padding: 8px 0 40px; }

  /* analyzing loader */
  .anhead { display: flex; align-items: center; gap: 16px; margin: 10px 0 6px; }
  .anhead .pt {
    width: 52px; height: 52px; border-radius: 12px;
    background: linear-gradient(135deg, #2f4636, #7da06d); flex: none;
  }
  .anhead h2 { font-family: var(--font-display); font-weight: 450; font-size: 26px; line-height: 1.1; }
  .anhead .meta { font-size: 12px; color: var(--muted); margin-top: 4px; }
  .barwrap { height: 4px; border-radius: 999px; background: rgba(255,255,255,.06); overflow: hidden; margin: 22px 0; }
  .barwrap .b { height: 100%; width: 0; border-radius: 999px; background: linear-gradient(90deg, var(--gold-deep), var(--mint)); transition: width .6s var(--ease); }
  .steps { display: grid; gap: 10px; }
  .steps .st {
    display: flex; align-items: center; gap: 12px; padding: 12px 14px;
    border: 1px solid var(--line); border-radius: 12px; opacity: .4; transition: opacity .4s, border-color .4s;
  }
  .steps .st.run { opacity: 1; border-color: rgba(236,188,78,.35); }
  .steps .st.done { opacity: .85; border-color: rgba(95,208,173,.28); }
  .steps .sd { margin-left: auto; font-variant-numeric: tabular-nums; opacity: .7; font-size: .85em; }
  .steps .dotc {
    width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center;
    font-size: 12px; color: transparent; border: 1px solid var(--line-2); flex: none;
  }
  .steps .st.done .dotc { color: var(--mint); border-color: rgba(95,208,173,.5); }
  .steps .st.run .dotc {
    color: transparent; border-color: var(--gold);
    animation: spin 1s linear infinite; border-top-color: transparent;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .an-error {
    margin-top: 18px; padding: 14px 16px; border-radius: 12px;
    border: 1px solid rgba(233,106,76,.4); background: rgba(233,106,76,.07);
    color: #f0a892; font-size: 14px; white-space: pre-wrap;
  }

  /* header */
  .rephead { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; flex-wrap: wrap; margin-bottom: 8px; }
  .rl { display: flex; gap: 18px; align-items: flex-start; }
  .rthumb { width: 66px; height: 66px; border-radius: 14px; background: linear-gradient(135deg, #2f4636, #7da06d); flex: none; margin-top: 3px; border: 1px solid var(--line); }
  .chip {
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--mint); border: 1px solid rgba(95, 208, 173, 0.35); border-radius: 999px;
    padding: 4px 11px; display: inline-block; margin-bottom: 14px;
  }
  .rephead h2 { font-family: var(--font-display); font-weight: 450; font-size: clamp(26px, 4vw, 40px); line-height: 1.05; letter-spacing: -0.015em; }
  .when { font-size: 11.5px; color: var(--muted); margin-top: 8px; }

  /* scorecard */
  .scorecard {
    display: grid; grid-template-columns: auto 1fr; gap: 30px; align-items: center;
    padding: 28px; margin-top: 24px; border: 1px solid var(--line); border-radius: var(--r);
    background: radial-gradient(110% 130% at 0 0, rgba(95, 208, 173, 0.1), transparent 55%);
  }
  @media (max-width: 620px) { .scorecard { grid-template-columns: 1fr; text-align: center; justify-items: center; } }
  .gauge { position: relative; width: 148px; height: 148px; }
  .gauge .val { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
  .gauge .num { font-family: var(--font-display); font-weight: 500; font-size: 44px; line-height: 1; color: var(--ink); }
  .gauge .den { font-family: var(--font-mono); font-size: 11px; color: var(--muted); margin-top: 3px; }
  .verdict .vt { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--mint); margin-bottom: 8px; }
  .verdict h3 { font-family: var(--font-display); font-weight: 450; font-size: 26px; margin-bottom: 8px; line-height: 1.1; display: flex; align-items: center; gap: 10px; }
  .verdict p { color: var(--ink-soft); font-weight: 330; max-width: 52ch; font-size: 15px; }

  /* sections */
  .sec { margin-top: 32px; }
  .sectitle {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--muted); margin-bottom: 16px; display: flex; align-items: center; gap: 10px;
  }
  .sectitle::after { content: ""; flex: 1; height: 1px; background: var(--line-2); }

  /* ranking cards */
  .mkts { display: grid; gap: 12px; }
  .mkt {
    border: 1px solid var(--line); border-radius: 14px; padding: 16px 18px;
    display: flex; flex-direction: column; gap: 9px; background: rgba(255, 255, 255, 0.015);
    transition: border-color 0.3s, transform 0.3s;
  }
  .mkt:hover { border-color: rgba(236, 235, 227, 0.22); transform: translateY(-2px); }
  .mkt .mh { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .mkt .fl { display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 16px; }
  .mkt .fl .rk { font-family: var(--font-mono); font-size: 12px; color: var(--faint); width: 22px; }
  .mkt .fl .fg { font-size: 22px; }
  .mkt .sc { font-family: var(--font-mono); font-weight: 600; font-size: 18px; color: var(--gold); }
  .mkt .sc small { font-size: 11px; color: var(--muted); }
  .mkt .mtrack { height: 6px; border-radius: 999px; background: rgba(255, 255, 255, 0.06); overflow: hidden; }
  .mkt .mfill { height: 100%; width: 0; border-radius: 999px; background: linear-gradient(90deg, var(--gold-deep), var(--gold)); transition: width 1s var(--ease); }
  .mkt .band { font-size: 13.5px; color: var(--ink-soft); }
  .mkt .flags { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 2px; }
  .mkt .tag {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: .06em; text-transform: uppercase;
    padding: 3px 9px; border-radius: 999px; border: 1px solid var(--line-2); color: var(--muted);
  }
  .mkt .tag.cap { color: #f0a892; border-color: rgba(233,106,76,.35); }
  .mkt .tag.warn { color: #ecbc4e; border-color: rgba(236,188,78,.45); background: rgba(236,188,78,.06); cursor: help; }
  .mkt .tag.king { color: #ecbc4e; border-color: rgba(236,188,78,.55); background: rgba(236,188,78,.09); }
  .mkt.excluded { opacity: .6; }
  /* off-request champion (the product's best market, shown for benchmark) */
  .mkt .fl .crown { font-size: 18px; width: 22px; text-align: center; filter: drop-shadow(0 0 6px rgba(236,188,78,.5)); }
  .mkt.champion { border-color: rgba(236,188,78,.5); background: rgba(236,188,78,.05); }
  .mkt.champion:hover { border-color: rgba(236,188,78,.8); }
  .mkt.not-requested { border-style: dashed; }

  /* narrative */
  .narrative { display: flex; flex-direction: column; gap: 14px; }
  .narrative p { font-size: 15.5px; line-height: 1.7; color: var(--ink-soft); font-weight: 330; }
  /* Distinguishable from real content at a glance: the narrative arrives after
     the scores, so this placeholder must not read as the analysis itself. */
  .narrative p.narrative-pending { opacity: 0.55; font-style: italic; }
  .narrative h4 { font-size: 17px; font-weight: 600; color: var(--ink); margin-top: 6px; }
  .narrative ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; }
  .narrative li { font-size: 15.5px; line-height: 1.7; color: var(--ink-soft); }
  .narrative strong { color: var(--ink); font-weight: 600; }
  .ai-notice { margin-top: 12px; font-size: 13px; color: var(--ink-soft); opacity: 0.75; }

  /* action bar */
  .actions {
    position: sticky; bottom: 0; margin-top: 40px; padding: 16px;
    border: 1px solid var(--line); border-radius: 16px;
    background: linear-gradient(180deg, rgba(18, 21, 18, 0.7), rgba(12, 14, 12, 0.92));
    backdrop-filter: blur(14px); display: flex; gap: 12px; align-items: center; justify-content: space-between; flex-wrap: wrap;
  }
  .actions .lft { font-size: 12px; color: var(--muted); }
  .actions .lft b { color: var(--ink); }
  .actions .grp { display: flex; gap: 10px; flex-wrap: wrap; }
</style>

<script>
  import {
    getAnalysis,
    fetchCountries,
    isTerminalStatus,
    subscribeStatus,
    num,
    flag,
    countryName,
    mosTier,
    slugForId,
    idFromSlug,
    type AnalysisStatusResponse,
    type MosResult,
    type CountryEvidence,
  } from "../lib/api";
  import { renderGroupedScores, signalDimension } from "../lib/grouped-scores";
  import { t } from "../lib/i18n";

  const POLL_MS = 2500;
  // Used only while the live stream is not delivering. The stream pushes every
  // change, so polling alongside it is duplicated work and duplicated redraws.
  const POLL_BACKUP_MS = 15000;
  const MAX_MS = 6 * 60 * 1000; // stop polling after ~6 minutes

  function el(tag: string, html: string, cls?: string): HTMLElement {
    const node = document.createElement(tag);
    if (cls) node.className = cls;
    node.innerHTML = html;
    return node;
  }

  // effective MOS for sorting/gauge: prefer capped `mos`, fall back to raw.
  function mosOf(r: MosResult): number | null {
    return num(r.mos) ?? num(r.mos_before_cap);
  }
  function isScored(r: MosResult): boolean {
    return mosOf(r) !== null && !r.excluded_reason;
  }

  let escDiv: HTMLElement | null = null;
  function escapeHtml(s: string): string {
    if (!escDiv) escDiv = document.createElement("div");
    escDiv.textContent = s ?? "";
    return escDiv.innerHTML;
  }

  /* ---------- comparison table: MOS + every score across all countries ---------- */
  function buildComparison(countries: CountryEvidence[]): void {
    const sec = document.getElementById("r-comparison-sec")!;
    const table = document.getElementById("r-comparison") as HTMLTableElement;
    if (countries.length === 0) {
      sec.style.display = "none";
      return;
    }
    sec.style.display = "block";
    table.innerHTML = "";

    // canonical row order from the first country: MOS, then each dimension with
    // its nested signals, then the context-only signals. Same set across all
    // countries, so column values are looked up by key per country.
    type Row = { kind: "mos" | "dim" | "sig" | "ctx"; label: string; key: string };
    const first = countries[0];
    const rows: Row[] = [{ kind: "mos", label: "MOS", key: "__mos__" }];
    for (const dim of first.dimensions ?? []) {
      rows.push({ kind: "dim", label: dim.label, key: dim.dimension });
      for (const s of (first.signals ?? []).filter((x) => signalDimension(x) === dim.dimension)) {
        rows.push({ kind: "sig", label: s.label, key: s.code });
      }
    }
    for (const s of (first.signals ?? []).filter((x) => signalDimension(x) === "context")) {
      rows.push({ kind: "ctx", label: s.label, key: s.code });
    }

    const dimMap = new Map<string, Map<string, number>>();
    const sigMap = new Map<string, Map<string, number>>();
    const mosMap = new Map<string, number | null>();
    for (const c of countries) {
      dimMap.set(c.country, new Map((c.dimensions ?? []).map((d) => [d.dimension, d.score])));
      sigMap.set(c.country, new Map((c.signals ?? []).map((s) => [s.code, s.score])));
      mosMap.set(c.country, num(c.mos));
    }
    const valueFor = (row: Row, country: string): number | null => {
      if (row.kind === "mos") return mosMap.get(country) ?? null;
      if (row.kind === "dim") return dimMap.get(country)?.get(row.key) ?? null;
      return sigMap.get(country)?.get(row.key) ?? null;
    };

    const thead = document.createElement("thead");
    thead.innerHTML =
      `<tr><th class="metric">${t("rep.metric")}</th>` +
      countries
        .map((c) => {
          const crown = c.is_champion ? `<span class="crown" title="${escapeHtml(t("rep.champion"))}">👑</span> ` : "";
          const cls = c.is_champion ? ' class="champion"' : "";
          return `<th${cls}>${crown}<span class="fg">${flag(c.country)}</span> ${escapeHtml(countryName(c.country))}</th>`;
        })
        .join("") +
      `</tr>`;
    table.appendChild(thead);

    const tbody = document.createElement("tbody");
    for (const row of rows) {
      const vals = countries.map((c) => valueFor(row, c.country));
      const present = vals.filter((v): v is number => v !== null);
      const best = present.length > 1 ? Math.max(...present) : null;
      let cells = `<th class="metric">${escapeHtml(row.label)}</th>`;
      for (const v of vals) {
        if (v === null) {
          cells += `<td class="na">—</td>`;
          continue;
        }
        const color = mosTier(v).color;
        const isBest = best !== null && Math.abs(v - best) < 0.05;
        cells += `<td class="${isBest ? "best" : ""}"><span class="v" style="color:${color}">${Math.round(v)}</span></td>`;
      }
      const tr = document.createElement("tr");
      tr.className = `cmp-${row.kind}`;
      tr.innerHTML = cells;
      tbody.appendChild(tr);
    }
    table.appendChild(tbody);
  }

  /* ---------- analyzing loader, driven by what the run is actually doing ---------- */

  /**
   * Which step the backend's progress line belongs to.
   *
   * These phrases come from the orchestrator's nodes. An unrecognised one holds
   * the current step rather than resetting the bar: a run that reports
   * something new should not look like it started over.
   */
  function stepFor(progress: string | null | undefined): number | null {
    const p = (progress ?? "").toLowerCase();
    if (!p) return null;
    if (p.includes("vocabulary")) return 0;
    if (p.startsWith("collecting") || p.includes("demand ruler")) return 1;
    if (p.startsWith("measuring")) return 2;
    if (p.includes("scoring") || p.includes("best market") || p.includes("evidence")) return 3;
    if (p.includes("explanation")) return 4;
    return null;
  }

  /** The ISO3 a progress line names, when it names one ("collecting ESP"). */
  function countryIn(progress: string | null | undefined): string | null {
    const m = /\b([A-Z]{3})\b/.exec(progress ?? "");
    return m ? m[1] : null;
  }

  let loaderStep = 0;
  function startLoader() {
    loaderStep = 0;
    paintLoader();
  }

  /**
   * Advance from the run's own progress line instead of a timer.
   *
   * It used to animate on an interval and park on the last step: after about
   * ten seconds the bar stopped meaning anything, while the run still had
   * minutes of real work left. The backend has been reporting what it is doing
   * all along — collecting a named country, settling the ruler, scoring — and
   * none of it reached the screen.
   */
  function advanceLoader(progress: string | null | undefined) {
    const step = stepFor(progress);
    // Never go backwards. Crowning the champion can collect, and a bar that
    // retreats reads as work being redone.
    if (step !== null && step > loaderStep) loaderStep = step;
    paintLoader(progress);
  }

  function paintLoader(progress?: string | null) {
    const steps = Array.from(document.querySelectorAll<HTMLElement>("#steps .st"));
    const bar = document.getElementById("anbar");
    if (!steps.length) return;
    steps.forEach((s, k) => {
      s.classList.toggle("run", k === loaderStep);
      s.classList.toggle("done", k < loaderStep);
      // The country the step is on, when the run named one. The label itself
      // stays translated; only the code is appended.
      const detail = s.querySelector<HTMLElement>(".sd");
      if (detail) detail.textContent = k === loaderStep ? (countryIn(progress) ?? "") : "";
    });
    if (bar) bar.style.width = `${Math.round(((loaderStep + 0.5) / steps.length) * 100)}%`;
  }

  function stopLoader() {
    loaderStep = 0;
  }

  /* ---------- render ---------- */
  /**
   * The narrative is no longer part of the answer the Core returns.
   *
   * It is a single LLM call that used to sit between a finished MOS and the
   * response — 249s of a 192s analysis, measured. The Core now marks the
   * request done with its scores and attaches the text a moment later, so
   * GET /analyze/{id} legitimately returns status=done with explanation=null
   * for a short window.
   *
   * Three states, therefore, not two: absent-and-coming, present, and
   * absent-for-good. Hiding the section on null would have shown a complete
   * report with a silently missing section and no reason given.
   */
  function appendInline(parent: HTMLElement, text: string): void {
    text.split(/(\*\*[^*]+\*\*)/g).forEach((part) => {
      if (!part) return;
      if (part.startsWith("**") && part.endsWith("**") && part.length > 4) {
        const strong = document.createElement("strong");
        strong.textContent = part.slice(2, -2);
        parent.appendChild(strong);
      } else {
        parent.appendChild(document.createTextNode(part));
      }
    });
  }

  function markdownBlock(block: string): HTMLElement {
    const heading = block.match(/^#{1,4}\s+(.*)$/);
    if (heading && !block.includes("\n")) {
      const h = document.createElement("h4");
      appendInline(h, heading[1]);
      return h;
    }
    const lines = block.split("\n");
    if (lines.every((l) => /^\s*[-*]\s+/.test(l))) {
      const ul = document.createElement("ul");
      lines.forEach((l) => {
        const li = document.createElement("li");
        appendInline(li, l.replace(/^\s*[-*]\s+/, ""));
        ul.appendChild(li);
      });
      return ul;
    }
    const p = document.createElement("p");
    appendInline(p, block.replace(/^#{1,4}\s+/, ""));
    return p;
  }

  function renderNarrative(text: string | null, pending = false): void {
    const sec = document.getElementById("r-narrative-sec")!;
    const body = document.getElementById("r-narrative")!;
    body.innerHTML = "";

    if (text && text.trim()) {
      sec.style.display = "block";
      // The model writes light Markdown (## headings, - lists, **bold**).
      // Rendered here as DOM nodes with textContent only: the text never
      // becomes HTML, so nothing it contains can run in the page.
      text
        .split(/\n\s*\n/)
        .map((p) => p.trim())
        .filter(Boolean)
        .forEach((block) => body.appendChild(markdownBlock(block)));
      return;
    }

    if (pending) {
      sec.style.display = "block";
      const node = document.createElement("p");
      node.className = "narrative-pending";
      node.textContent = t("rep.narrativePending");
      body.appendChild(node);
      return;
    }

    sec.style.display = "none";
  }

  function render(a: AnalysisStatusResponse, showActions: boolean) {
    const state = document.getElementById("r-state")!;
    const body = document.getElementById("r-body")!;

    // Off-request champion first, then the requested markets by MOS.
    //
    // Sorting purely by MOS buried it: a champion scoring 66 landed between the
    // #1 requested market at 69 and the #2 at 42, reading as an unnumbered card
    // dropped into the middle of the ranking. It is not a rank position — it is
    // the answer to a different question ("the product's best market, which you
    // did not ask about"), so it belongs above the ranking rather than inside
    // it. The rank numbers already count requested markets only, so pinning it
    // to the top leaves #1/#2/#3 contiguous.
    const results = (a.result ?? []).slice().sort((x, y) => {
      const cx = x.requested === false ? 0 : 1;
      const cy = y.requested === false ? 0 : 1;
      if (cx !== cy) return cx - cy;
      const mx = mosOf(x), my = mosOf(y);
      if (mx === null && my === null) return 0;
      if (mx === null) return 1;
      if (my === null) return -1;
      return my - mx;
    });

    // A result flagged `requested === false` is the off-request reference
    // "champion" (the product's best-MOS market), surfaced for benchmark only.
    const isRequested = (r: MosResult) => r.requested !== false;
    const requestedResults = results.filter(isRequested);
    // Single-market framing follows the REQUESTED markets: a champion added for
    // benchmark doesn't turn a 1-country request into a ranking (no rank #s).
    const single = requestedResults.length <= 1;

    // header
    document.getElementById("r-title")!.textContent = a.canonical_title ?? "Product";
    const scored = results.filter(isScored);
    // The big scorecard highlights the best REQUESTED market (not the off-request
    // champion), so the user's own pick stays the headline.
    const top = scored.find(isRequested) ?? scored[0] ?? results[0];
    const period = results[0]?.period_key ?? "";
    document.getElementById("r-when")!.textContent =
      [
        single ? "" : `${requestedResults.length} ${t("rep.ranking").toLowerCase()}`,
        period ? `${t("rep.period")} ${period}` : "",
      ]
        .filter(Boolean)
        .join(" · ");

    // scorecard from the top market
    const topMos = top ? mosOf(top) : null;
    const total = topMos !== null ? Math.round(topMos) : 0;
    const tier = mosTier(topMos);
    const chip = document.getElementById("r-chip")!;
    chip.textContent = t("tier." + tier.key);
    chip.style.color = tier.color;
    chip.style.borderColor = tier.border;
    chip.style.background = tier.bg;

    const vt = document.getElementById("r-vt")!;
    vt.style.color = tier.color;
    vt.textContent = single ? t("rep.themarket") : t("rep.topmarket");
    // ranking section title: "ranking" for many, "analysis" for a single market
    document.getElementById("r-ranking-title")!.textContent = single
      ? t("rep.analysis")
      : t("rep.ranking");
    document.getElementById("r-verdict")!.innerHTML = top
      ? `<span>${flag(top.country)}</span>${countryName(top.country)}`
      : "—";
    document.getElementById("r-summary")!.textContent = top?.mos_interpretation ?? "";

    const ring = document.getElementById("r-ring") as unknown as SVGCircleElement;
    const numEl = document.getElementById("r-num")!;
    const circ = 396;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) {
      ring.style.strokeDashoffset = String(circ - (circ * total) / 100);
      numEl.textContent = String(total);
    } else {
      requestAnimationFrame(() => {
        ring.style.transition = "stroke-dashoffset 1.4s cubic-bezier(.2,.7,.2,1)";
        ring.style.strokeDashoffset = String(circ - (circ * total) / 100);
      });
      let n = 0;
      const step = Math.max(1, Math.round(total / 39));
      const cnt = setInterval(() => {
        n += step;
        if (n >= total) { n = total; clearInterval(cnt); }
        numEl.textContent = String(n);
      }, 22);
    }

    // ranking list — each card carries the country's grouped deterministic
    // scores (dimension gauge + child signal gauges), from the evidence packet.
    const evByCountry = new Map<string, CountryEvidence>(
      (a.breakdown?.countries ?? []).map((c) => [c.country, c]),
    );
    const ranking = document.getElementById("r-ranking")!;
    ranking.innerHTML = "";
    let rank = 0; // rank # counts only requested markets (champion is crowned, not ranked)
    results.forEach((r) => {
      const m = mosOf(r);
      const excluded = !!r.excluded_reason;
      const requested = isRequested(r);
      const champ = !!r.is_champion;
      if (requested) rank += 1;
      const scoreHtml = m !== null ? `${Math.round(m)}<small>/100</small>` : `<small>${t("rep.na")}</small>`;
      const tags: string[] = [];
      // Off-request champion: flag it clearly as a benchmark, not a picked market.
      if (!requested) tags.push(`<span class="tag king">👑 ${t("rep.champion")}</span>`);
      if (r.capped_by) tags.push(`<span class="tag cap">${t("rep.cappedby")} ${r.capped_by}</span>`);
      if (excluded) tags.push(`<span class="tag">${t("rep.excluded")}: ${r.excluded_reason}</span>`);
      const band = r.mos_interpretation ?? r.explanation ?? "";
      const ev = evByCountry.get(r.country);
      if (ev?.demand_confidence === "low") {
        tags.push(
          `<span class="tag warn" title="${escapeHtml(ev.demand_confidence_note ?? "")}">⚠ ${t("rep.lowconfidence")}</span>`,
        );
      }
      const toggleHtml = ev
        ? `<button class="mkt-toggle" aria-expanded="false" aria-label="Expand details">▸</button>`
        : "";
      // Requested markets get a rank # (unless single); the champion gets a crown.
      const markHtml = champ
        ? `<span class="crown" title="${escapeHtml(t("rep.champion"))}">👑</span>`
        : !requested
          ? ""
          : single
            ? ""
            : `<span class="rk">#${rank}</span>`;
      const card = el(
        "div",
        `<div class="mh"><div class="fl">${markHtml}<span class="fg">${flag(r.country)}</span>${countryName(r.country)}</div>` +
          `<div class="mh-right"><div class="sc">${scoreHtml}</div>${toggleHtml}</div></div>` +
          `<div class="mtrack"><div class="mfill"></div></div>` +
          (band ? `<div class="band">${band}</div>` : "") +
          (tags.length ? `<div class="flags">${tags.join("")}</div>` : ""),
        "mkt" + (excluded ? " excluded" : "") + (ev ? " has-detail" : "") + (champ ? " champion" : "") +
          (!requested ? " not-requested" : ""),
      );
      ranking.appendChild(card);
      const fill = card.querySelector<HTMLElement>(".mfill")!;
      const w = `${Math.max(0, Math.min(100, m ?? 0))}%`;
      if (reduce) fill.style.width = w;
      else requestAnimationFrame(() => (fill.style.width = w));

      // grouped deterministic scores (progress bars), collapsed by default —
      // shown only when the user expands the card; re-animate on each open.
      if (ev) {
        const groups = document.createElement("div");
        groups.className = "gs-root gs-collapsed";
        card.appendChild(groups);
        const animateGroups = renderGroupedScores(groups, ev);
        const toggle = card.querySelector<HTMLButtonElement>(".mkt-toggle")!;
        const head = card.querySelector<HTMLElement>(".mh")!;
        let expanded = false;
        const setExpanded = (v: boolean) => {
          expanded = v;
          groups.classList.toggle("gs-collapsed", !expanded);
          toggle.classList.toggle("open", expanded);
          toggle.setAttribute("aria-expanded", String(expanded));
          if (expanded) animateGroups();
        };
        toggle.addEventListener("click", (e) => {
          e.stopPropagation();
          setExpanded(!expanded);
        });
        head.addEventListener("click", () => setExpanded(!expanded));
      }
    });

    // comparison table — MOS + every deterministic score across all countries.
    // Shown whenever there are ≥2 markets, so a single requested market still
    // gets a comparison against its off-request champion (nothing to compare
    // when there's only one market total).
    const orderedEv = results
      .map((r) => evByCountry.get(r.country))
      .filter((e): e is CountryEvidence => !!e);
    buildComparison(orderedEv.length >= 2 ? orderedEv : []);

    // narrative — rendered separately because it arrives after the scores
    renderNarrative(a.explanation);

    // action bar
    if (showActions) {
      const slug = slugForId(a.request_id);
      const actions = document.getElementById("r-actions")!;
      actions.style.display = "flex";
      document.getElementById("r-actions-summary")!.innerHTML = top
        ? `${flag(top.country)} <b>${countryName(top.country)}</b> · MOS <b>${total}/100</b> · ${t("rep.share")} <b>/r/${slug}</b>`
        : `${t("rep.share")} <b>/r/${slug}</b>`;
      const shareBtn = document.getElementById("r-share") as HTMLButtonElement;
      if (shareBtn.dataset.bound !== "1") {
        shareBtn.dataset.bound = "1";
        shareBtn.addEventListener("click", async () => {
          const url = `${location.origin}/r/${slug}`;
          try { await navigator.clipboard.writeText(url); }
          catch { window.prompt("Share this link:", url); }
          toast(`${t("rep.copied")} · ${location.host}/r/${slug}`);
        });
      }
    }

    stopLoader();
    state.style.display = "none";
    body.style.display = "block";
  }

  function fail(message: string) {
    stopLoader();
    const errBox = document.getElementById("an-error");
    const title = document.getElementById("an-title");
    const bar = document.getElementById("anbar");
    if (bar) bar.style.width = "100%";
    document.querySelectorAll("#steps .st").forEach((s) => s.classList.remove("run"));
    if (title) title.textContent = t("rep.failed");
    if (errBox) {
      errBox.style.display = "block";
      errBox.textContent = message;
    }
  }

  let toastTimer: ReturnType<typeof setTimeout> | undefined;
  function toast(html: string) {
    const box = document.getElementById("r-toast")!;
    document.getElementById("r-toast-msg")!.innerHTML = html;
    box.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => box.classList.remove("show"), 2600);
  }

  /* ---------- poll loop ---------- */
  function init() {
    const root = document.querySelector<HTMLElement>(".report-root");
    if (!root || root.dataset.bound === "1") return;
    root.dataset.bound = "1";

    const parts = location.pathname.split("/").filter(Boolean);
    const seg = parts[parts.length - 1];
    if (!seg || seg === "_") return;

    const isSlug = parts[0] === "r" || root.dataset.fromSlug === "1";
    const showActions = parts[0] === "r" ? false : root.dataset.showActions === "1";
    const id = isSlug ? idFromSlug(seg) : seg;

    startLoader();
    const started = Date.now();
    let stopped = false;
    let scoresShown = false;

    /** Draw whatever the Core has now. Returns true when nothing is left to wait for. */
    const draw = async (): Promise<boolean> => {
      const a = await getAnalysis(id);
      if (a.status.toLowerCase() === "failed") {
        fail(a.error_message ?? "Analysis failed.");
        return true;
      }
      if (!isTerminalStatus(a.status)) {
        advanceLoader(a.progress); // not terminal: say what it is doing
        return false;
      }
      const narrative = a.explanation && a.explanation.trim() ? a.explanation : null;
      if (!scoresShown) {
        scoresShown = true;
        await fetchCountries().catch(() => []); // names/flags resolve from this cache
        render(a, showActions); // render() draws the narrative it was given
      } else if (narrative) {
        renderNarrative(narrative);
      }
      // The scores are the answer and the text is a reading of them, so the
      // scores go up without it and the section says the text is coming.
      if (!narrative) renderNarrative(null, true);
      return Boolean(narrative);
    };

    const finish = () => {
      stopped = true;
    };

    /**
     * Listen, do not ask.
     *
     * The Core pushes on every change — the progress line, the scores, and the
     * narrative, which lands after the scores and is the slow one. It holds the
     * stream open past `done` until the text is there, so the moment the answer
     * exists the screen is told. Polling for it meant the answer sat finished in
     * the database while the screen still said it was being written.
     *
     * Polling stays as the fallback, because SSE is the first thing a proxy
     * breaks and a silent stream must not become a page that never finishes.
     */
    let usingStream = false;
    const closeStream = subscribeStatus(
      id,
      (event) => {
        if (stopped) return true;
        usingStream = true;
        if (event.status.toLowerCase() === "failed") {
          void draw().then(finish);
          return true;
        }
        if (!isTerminalStatus(event.status)) {
          advanceLoader(event.progress ?? null);
          return false;
        }
        // Terminal. The scores go up now; the narrative when it lands, or the
        // section disappears when the Core says it is not coming.
        const abandoned = event.narrative_abandoned === true;
        void draw().then((complete) => {
          if (abandoned && !complete) renderNarrative(null); // hide rather than pretend
          if (complete || abandoned) finish();
        });
        return Boolean(event.has_explanation) || abandoned;
      },
      () => {
        // The stream died. The poll below is already running and takes over.
        usingStream = false;
      },
    );

    const tick = async () => {
      if (stopped) return;
      try {
        if (await draw()) {
          finish();
          closeStream();
          return;
        }
      } catch (err) {
        // A share view opened before the request exists (404) keeps polling;
        // any other error stops with a message.
        if (err instanceof Error && err.message !== "Analysis not found") {
          finish();
          closeStream();
          fail(err.message);
          return;
        }
      }
      if (Date.now() - started > MAX_MS) {
        finish();
        closeStream();
        fail("Timed out waiting for the analysis to finish.");
        return;
      }
      // Slow right down while the stream is doing the work: the poll is only
      // here in case the stream is not.
      setTimeout(tick, usingStream ? POLL_BACKUP_MS : POLL_MS);
    };
    tick();
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
