---
import Base from "../layouts/Base.astro";
---

<Base title="MarketMind AI — Analyze a Product" activeTab="analyze" home={true}>
  <!-- ============================ UPLOAD ============================ -->
  <section class="screen" id="screen-upload">
    <div class="eyebrow" data-i18n="idx.eyebrow">New analysis</div>
    <h1 data-i18n-html="idx.h1">Analyze a <em>product</em></h1>
    <p class="sub" data-i18n="idx.sub">
      Add a product photo, describe it, and pick the target markets.
    </p>

    <form id="analyze-form" class="card uploadgrid">
      <div class="drop">
        <div class="lab"><span data-i18n="idx.images">Product image</span><span id="imgcount">0 added</span></div>
        <div class="dropzone" id="dropzone" tabindex="0" role="button" aria-label="Add product images">
          <input id="file-input" type="file" accept="image/*" multiple hidden />
          <div class="thumbs" id="thumbs"></div>
          <div class="dzcta">
            <div class="ic">+</div>
            <b data-i18n="idx.drop">Drag a photo here, or click to add</b>
            <small data-i18n="idx.dropsmall">JPG / PNG · the first image is used for identification</small>
          </div>
        </div>
      </div>

      <div class="descbox">
        <div class="lab"><span data-i18n="idx.description">Description</span><span data-i18n="idx.freetext">free text</span></div>
        <textarea id="desc" name="description" spellcheck="false" required
          data-i18n-ph="idx.placeholder"
          placeholder="Describe your product in a sentence or two…"></textarea>
      </div>
    </form>

    <!-- target markets -->
    <div class="card markets-card">
      <div class="lab"><span data-i18n="idx.markets">Target markets</span><span id="mkt-count">0</span></div>
      <div class="hint markets-hint" data-i18n="idx.markets.hint">Pick the countries to score.</div>
      <div class="cpick" id="cpick"></div>
    </div>

    <div class="runbar">
      <div class="hint" data-i18n-html="idx.hint">Vision + enrichment identify the product — <b>you confirm</b> first.</div>
      <button class="btn" id="analyzeBtn" type="submit" form="analyze-form">
        <span data-i18n="idx.btn">Identify product</span> <span class="ar">→</span>
      </button>
    </div>
    <div id="status" class="mono faint" style="margin-top: 14px; font-size: 0.8rem; min-height: 1.2em;"></div>
  </section>

  <!-- ============================ REVIEW ============================ -->
  <section class="screen" id="screen-review" style="display: none;">
    <div class="eyebrow" data-i18n="rev.eyebrow">Review &amp; confirm</div>
    <h1 data-i18n="rev.title">Confirm before analyzing</h1>
    <p class="sub" data-i18n="rev.sub">Correct anything the model got wrong. Nothing is collected until you confirm.</p>

    <!-- identity -->
    <div class="card rev-card">
      <div class="sectitle" data-i18n="rev.identity">Product identity</div>
      <div class="idgrid">
        <label class="fld fld-2"><span data-i18n="rev.name">Product name</span><input id="f-name" type="text" /></label>
        <label class="fld"><span data-i18n="rev.brand">Brand</span><input id="f-brand" type="text" /></label>
        <label class="fld"><span data-i18n="rev.category">Category</span><input id="f-category" type="text" /></label>
        <label class="fld"><span data-i18n="rev.price">Est. price</span><input id="f-price" type="number" step="0.01" min="0" /></label>
        <label class="fld"><span data-i18n="rev.currency">Currency</span><input id="f-currency" type="text" maxlength="3" /></label>
        <label class="fld"><span data-i18n="rev.agemin">Age min</span><input id="f-agemin" type="number" min="0" /></label>
        <label class="fld"><span data-i18n="rev.agemax">Age max</span><input id="f-agemax" type="number" min="0" /></label>
      </div>
    </div>

    <p class="sub rev-note" data-i18n="rev.note">The search vocabulary per market is generated automatically — you only confirm the product identity above.</p>

    <div class="runbar">
      <button class="btn ghost" id="backBtn" type="button"><span class="ar">←</span> <span data-i18n="rev.back">Back</span></button>
      <button class="btn" id="confirmBtn" type="button">
        <span data-i18n="rev.analyze">Confirm &amp; analyze</span> <span class="ar">→</span>
      </button>
    </div>
    <div id="rev-status" class="mono faint" style="margin-top: 14px; font-size: 0.8rem; min-height: 1.2em;"></div>
  </section>
</Base>

<style is:global>
  .uploadgrid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 16px;
    margin-top: 30px;
  }
  @media (max-width: 760px) {
    .uploadgrid { grid-template-columns: 1fr; }
  }
  .drop, .descbox { padding: 22px; display: flex; flex-direction: column; }
  .descbox textarea { flex: 1; min-height: 200px; }
  .lab {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 14px;
    display: flex;
    justify-content: space-between;
  }
  .dropzone {
    flex: 1;
    border: 1.5px dashed rgba(236, 235, 227, 0.18);
    border-radius: 14px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: border-color 0.3s, background 0.3s;
    cursor: pointer;
    min-height: 200px;
  }
  .dropzone:hover, .dropzone:focus, .dropzone.drag {
    border-color: rgba(236, 188, 78, 0.5);
    background: rgba(236, 188, 78, 0.03);
    outline: none;
  }
  .thumbs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 9px; }
  .thumb {
    aspect-ratio: 1; border-radius: 10px; position: relative; overflow: hidden;
    border: 1px solid var(--line); display: flex; align-items: flex-end;
    animation: pop 0.4s var(--ease);
  }
  .thumb img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  @keyframes pop { from { opacity: 0; transform: scale(0.86); } to { opacity: 1; transform: none; } }
  .thumb .cap {
    position: relative; z-index: 1; font-family: var(--font-mono); font-size: 9px;
    color: rgba(255, 255, 255, 0.82); padding: 5px 6px;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.55), transparent);
    width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .dzcta {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 8px; color: var(--muted); text-align: center; padding: 18px 0; margin-top: auto;
  }
  .dzcta .ic {
    width: 42px; height: 42px; border-radius: 12px; border: 1px solid var(--line);
    display: grid; place-items: center; font-size: 20px; color: var(--gold);
    background: rgba(236, 188, 78, 0.05);
  }
  .dzcta b { color: var(--ink-soft); font-weight: 600; font-size: 14px; }
  .dzcta small { font-size: 12px; }

  /* country picker */
  .markets-card { padding: 22px; margin-top: 16px; }
  .markets-hint { margin-bottom: 14px; }
  .cpick { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  /* full-width break so chips group under each continent heading */
  .cpick-cont {
    width: 100%; margin: 10px 0 2px; font-family: var(--font-mono);
    font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--faint);
  }
  .cpick-cont:first-child { margin-top: 0; }
  .cpick .cchip {
    display: inline-flex; align-items: center; gap: 7px; cursor: pointer;
    font-size: 13px; color: var(--ink-soft);
    border: 1px solid var(--line-2); border-radius: 999px; padding: 7px 13px;
    background: transparent; transition: border-color .2s, background .2s, color .2s;
    user-select: none;
  }
  .cpick .cchip .fg { font-size: 15px; }
  .cpick .cchip:hover { border-color: rgba(236, 235, 227, 0.28); }
  .cpick .cchip.on {
    color: var(--ink); border-color: rgba(95, 208, 173, 0.5);
    background: rgba(95, 208, 173, 0.08);
  }

  .runbar {
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px; margin-top: 18px; flex-wrap: wrap;
  }
  .hint { font-size: 13px; color: var(--muted); font-family: var(--font-mono); }
  .hint b { color: var(--mint); }

  /* button loading spinner */
  .btn.loading { pointer-events: none; opacity: 0.9; display: inline-flex; align-items: center; gap: 9px; }
  .btnspin {
    width: 15px; height: 15px; flex: none; border-radius: 50%;
    border: 2px solid rgba(0, 0, 0, 0.25); border-top-color: currentColor;
    animation: btnspin 0.8s linear infinite;
  }
  @keyframes btnspin { to { transform: rotate(360deg); } }

  /* review */
  .rev-card { padding: 22px; margin-top: 16px; }
  .rev-card .sectitle {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--muted); margin-bottom: 16px;
    display: flex; align-items: center; gap: 10px;
  }
  .rev-card .sectitle::after { content: ""; flex: 1; height: 1px; background: var(--line-2); }
  .rev-card .hint { margin: -8px 0 16px; }
  .idgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  @media (max-width: 720px) { .idgrid { grid-template-columns: repeat(2, 1fr); } }
  .fld { display: flex; flex-direction: column; gap: 6px; }
  .fld.fld-2 { grid-column: span 2; }
  .fld > span {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--muted);
  }
  .fld input, .fld textarea, .mkt-edit input, .mkt-edit textarea {
    background: rgba(255, 255, 255, 0.02); border: 1px solid var(--line);
    border-radius: 10px; padding: 10px 12px; color: var(--ink);
    font-family: inherit; font-size: 14px; width: 100%;
  }
  .fld input:focus, .mkt-edit input:focus, .mkt-edit textarea:focus {
    outline: none; border-color: rgba(236, 188, 78, 0.5);
  }
  .rev-markets { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  @media (max-width: 720px) { .rev-markets { grid-template-columns: 1fr; } }
  .mkt-edit {
    border: 1px solid var(--line); border-radius: 14px; padding: 16px 18px;
    display: flex; flex-direction: column; gap: 12px; background: rgba(255, 255, 255, 0.015);
  }
  .mkt-edit .mh { display: flex; align-items: center; gap: 10px; }
  .mkt-edit .mh .fg { font-size: 20px; }
  .mkt-edit .mh b { font-size: 15px; }
  .mkt-edit .mh .conf {
    margin-left: auto; font-family: var(--font-mono); font-size: 11px; color: var(--faint);
  }
  .mkt-edit label { display: flex; flex-direction: column; gap: 5px; }
  .mkt-edit label > span {
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--muted);
  }
  .mkt-edit textarea { min-height: 46px; resize: vertical; }
</style>

<script>
  import {
    identifyImage,
    analyze,
    fileToImagePayload,
    saveRequest,
    fetchCountries,
    flag,
    type IdentifyImageResult,
  } from "../lib/api";
  import { getLang, t } from "../lib/i18n";

  const PALETTE = [
    "linear-gradient(135deg,#2f4636,#7da06d)",
    "linear-gradient(135deg,#3a3326,#b89a5e)",
    "linear-gradient(135deg,#26343a,#5e93b8)",
    "linear-gradient(135deg,#3a2630,#b85e86)",
  ];

  // Flow state (persists — no navigation between upload and review).
  let files: File[] = [];
  let selected = new Set<string>(); // no countries pre-selected — user picks
  let identified: IdentifyImageResult | null = null;
  let userPrompt = ""; // the buyer's free-text description — carried through to /analyze

  function esc(s: string): string {
    return s.replace(/[&<>"]/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c] ?? c,
    );
  }

  // Loading state for an action button: swap its content for a spinner + label,
  // disable it, and restore on completion. Prevents the "did it freeze?" feel
  // during the (slow) identify and the analyze submit.
  function setLoading(btn: HTMLButtonElement, on: boolean, label?: string): void {
    if (on) {
      if (!btn.dataset.orig) btn.dataset.orig = btn.innerHTML;
      btn.classList.add("loading");
      btn.disabled = true;
      btn.innerHTML = `<span class="btnspin"></span><span>${esc(label ?? "")}</span>`;
    } else {
      btn.classList.remove("loading");
      btn.disabled = false;
      if (btn.dataset.orig) {
        btn.innerHTML = btn.dataset.orig;
        delete btn.dataset.orig;
      }
    }
  }

  // Empty the description and the images once an analysis is sent; the
  // markets stay picked for the next product.
  function clearProduct() {
    userPrompt = "";
    files.length = 0;
    (document.getElementById("desc") as HTMLTextAreaElement).value = "";
    (document.getElementById("file-input") as HTMLInputElement).value = "";
    document.getElementById("thumbs")!.innerHTML = "";
    document.getElementById("imgcount")!.textContent = `0 ${t("idx.added")}`;
  }

  /* ---------- upload screen ---------- */
  function bindUpload() {
    const form = document.getElementById("analyze-form") as HTMLFormElement | null;
    if (!form || form.dataset.bound === "1") return;
    form.dataset.bound = "1";

    const dropzone = document.getElementById("dropzone")!;
    const fileInput = document.getElementById("file-input") as HTMLInputElement;
    const thumbs = document.getElementById("thumbs")!;
    const imgcount = document.getElementById("imgcount")!;
    const statusEl = document.getElementById("status")!;
    const submitBtn = document.getElementById("analyzeBtn") as HTMLButtonElement;

    // A fresh page has no thumbnails, so it holds no images either: the
    // module outlives the ClientRouter navigation that brought us back here.
    files.length = 0;
    imgcount.textContent = `${files.length} ${t("idx.added")}`;

    function renderThumbs() {
      thumbs.innerHTML = "";
      files.slice(0, 8).forEach((f, i) => {
        const node = document.createElement("div");
        node.className = "thumb";
        node.style.background = PALETTE[i % PALETTE.length];
        if (i === 0) node.style.viewTransitionName = "product-thumb";
        const img = document.createElement("img");
        img.src = URL.createObjectURL(f);
        img.alt = f.name;
        const cap = document.createElement("div");
        cap.className = "cap";
        cap.textContent = f.name;
        node.appendChild(img);
        node.appendChild(cap);
        thumbs.appendChild(node);
      });
      imgcount.textContent = `${files.length} ${t("idx.added")}`;
    }

    function addFiles(list: FileList | null) {
      if (!list) return;
      for (const f of Array.from(list)) {
        if (f.type.startsWith("image/") && files.length < 8) files.push(f);
      }
      renderThumbs();
    }

    dropzone.addEventListener("click", () => fileInput.click());
    dropzone.addEventListener("keydown", (e) => {
      const k = (e as KeyboardEvent).key;
      if (k === "Enter" || k === " ") { e.preventDefault(); fileInput.click(); }
    });
    fileInput.addEventListener("change", () => addFiles(fileInput.files));
    ["dragenter", "dragover"].forEach((evt) =>
      dropzone.addEventListener(evt, (e) => { e.preventDefault(); dropzone.classList.add("drag"); }),
    );
    ["dragleave", "drop"].forEach((evt) =>
      dropzone.addEventListener(evt, (e) => { e.preventDefault(); dropzone.classList.remove("drag"); }),
    );
    dropzone.addEventListener("drop", (e) => addFiles((e as DragEvent).dataTransfer?.files ?? null));

    // country picker — fetched from the Core (GET /countries), grouped by
    // continent and alphabetical within each (the API returns that order).
    const cpick = document.getElementById("cpick")!;
    const mktCount = document.getElementById("mkt-count")!;
    function renderCount() { mktCount.textContent = String(selected.size); }
    cpick.innerHTML = `<span class="mono faint" style="font-size:12px">…</span>`;
    fetchCountries()
      .then((list) => {
        cpick.innerHTML = "";
        let currentCont: string | null | undefined;
        list.forEach((c) => {
          if (c.continent !== currentCont) {
            currentCont = c.continent;
            const head = document.createElement("div");
            head.className = "cpick-cont";
            head.textContent = c.continent ?? "";
            cpick.appendChild(head);
          }
          const chip = document.createElement("button");
          chip.type = "button";
          chip.className = "cchip" + (selected.has(c.iso3) ? " on" : "");
          chip.dataset.iso3 = c.iso3;
          chip.innerHTML = `<span class="fg">${flag(c.iso2 ?? c.iso3)}</span>${esc(c.name)}`;
          chip.addEventListener("click", () => {
            if (selected.has(c.iso3)) { selected.delete(c.iso3); chip.classList.remove("on"); }
            else { selected.add(c.iso3); chip.classList.add("on"); }
            renderCount();
          });
          cpick.appendChild(chip);
        });
        renderCount();
      })
      .catch((err) => {
        cpick.innerHTML = `<span class="mono" style="color:#e96a4c;font-size:12px">${esc(err instanceof Error ? err.message : "Failed to load countries")}</span>`;
      });
    renderCount();

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const desc = (document.getElementById("desc") as HTMLTextAreaElement).value.trim();
      // The product can come from the IMAGE or the DESCRIPTION — at least one is
      // required (the image is no longer mandatory). Consistency check before
      // moving on to the product-detail (review) screen.
      if (!desc && files.length === 0) { statusEl.textContent = t("idx.err.productinfo"); return; }
      if (selected.size === 0) { statusEl.textContent = t("idx.err.markets"); return; }

      userPrompt = desc;
      setLoading(submitBtn, true, t("idx.identifying"));
      statusEl.textContent = t("idx.identifying.hint");
      try {
        // Image is optional: send it only if the user added one.
        const img = files.length > 0 ? await fileToImagePayload(files[0]) : null;
        identified = await identifyImage({
          imageBase64: img?.base64 ?? null,
          mediaType: img?.mediaType ?? null,
          hintText: desc || undefined,
          countries: Array.from(selected),
        });
        statusEl.textContent = "";
        showReview();
      } catch (err) {
        statusEl.textContent = err instanceof Error ? err.message : t("idx.err.failed");
      } finally {
        setLoading(submitBtn, false);
      }
    });
  }

  /* ---------- review screen ---------- */
  function showReview() {
    if (!identified) return;
    const up = document.getElementById("screen-upload");
    const rev = document.getElementById("screen-review");
    if (up) up.style.display = "none";
    if (rev) rev.style.display = "block";
    window.scrollTo({ top: 0, behavior: "smooth" });

    (document.getElementById("f-name") as HTMLInputElement).value = identified.product_name ?? "";
    (document.getElementById("f-brand") as HTMLInputElement).value = identified.brand ?? "";
    (document.getElementById("f-category") as HTMLInputElement).value = identified.category ?? "";
    (document.getElementById("f-price") as HTMLInputElement).value =
      identified.estimated_price != null ? String(identified.estimated_price) : "";
    (document.getElementById("f-currency") as HTMLInputElement).value = identified.price_currency ?? "";
    (document.getElementById("f-agemin") as HTMLInputElement).value =
      identified.target_age_min != null ? String(identified.target_age_min) : "";
    (document.getElementById("f-agemax") as HTMLInputElement).value =
      identified.target_age_max != null ? String(identified.target_age_max) : "";
    // The per-country search vocabulary + reference candidates are trusted from
    // the LLM (not user-curated) and passed straight through to /analyze — the
    // user only confirms the product identity above.
  }

  function numOrNull(id: string): number | null {
    const v = (document.getElementById(id) as HTMLInputElement).value.trim();
    if (!v) return null;
    const n = Number(v);
    return Number.isFinite(n) ? n : null;
  }
  function strOrNull(id: string): string | null {
    const v = (document.getElementById(id) as HTMLInputElement).value.trim();
    return v || null;
  }

  function bindReview() {
    const backBtn = document.getElementById("backBtn");
    if (backBtn && backBtn.dataset.bound !== "1") {
      backBtn.dataset.bound = "1";
      backBtn.addEventListener("click", () => {
        document.getElementById("screen-review")!.style.display = "none";
        document.getElementById("screen-upload")!.style.display = "block";
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }
    const confirmBtn = document.getElementById("confirmBtn") as HTMLButtonElement | null;
    if (confirmBtn && confirmBtn.dataset.bound !== "1") {
      confirmBtn.dataset.bound = "1";
      confirmBtn.addEventListener("click", async () => {
        if (!identified) return;
        const revStatus = document.getElementById("rev-status")!;

        // Search vocabulary + reference candidates are trusted from the LLM and
        // passed straight through — the user curates nothing here, only confirms
        // the product identity. (The backend also merges them into the entity.)
        const name = (document.getElementById("f-name") as HTMLInputElement).value.trim();
        if (!name) { revStatus.textContent = t("idx.err.desc"); return; }

        setLoading(confirmBtn, true, t("rev.analyzing"));
        revStatus.textContent = t("rev.submitting");
        try {
          const countries = Array.from(selected);
          const res = await analyze({
            product_name: name,
            brand: strOrNull("f-brand"),
            category: strOrNull("f-category"),
            localized_markets: identified.localized_markets ?? null,
            reference_candidates: identified.reference_candidates ?? null,
            target_age_min: numOrNull("f-agemin"),
            target_age_max: numOrNull("f-agemax"),
            estimated_price: numOrNull("f-price"),
            price_currency: strOrNull("f-currency"),
            user_prompt: userPrompt || null,
            countries,
            // The narrative comes out in the language the user is reading in.
            language: getLang(),
          });
          // Register in the pending-analyses dock and DON'T navigate: the
          // analysis runs in the background (dock shows it, streams status, and
          // toasts + turns green when done). The user is freed to queue more
          // analyses in parallel instead of staring at a loading screen.
          saveRequest({
            id: res.request_id,
            title: name,
            countries,
            status: res.status || "pending",
            createdAt: Date.now(),
          });
          window.dispatchEvent(new CustomEvent("mm:requests-changed", { detail: { started: name } }));
          setLoading(confirmBtn, false);
          revStatus.textContent = "";
          // back to the upload screen, ready for the next product
          identified = null;
          clearProduct();
          document.getElementById("screen-review")!.style.display = "none";
          document.getElementById("screen-upload")!.style.display = "block";
          window.scrollTo({ top: 0, behavior: "smooth" });
        } catch (err) {
          revStatus.textContent = err instanceof Error ? err.message : t("idx.err.failed");
          setLoading(confirmBtn, false);
        }
      });
    }
  }

  function init() {
    bindUpload();
    bindReview();
  }
  init();
  document.addEventListener("astro:page-load", init);
</script>
