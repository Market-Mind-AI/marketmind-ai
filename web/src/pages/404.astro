---
// Universal client-side fallback. Under `output: "static"` the dynamic
// [id]/[slug] routes only prerender a placeholder path, so a hard reload or a
// shared deep-link (e.g. /report/<uuid>, /r/<slug>) lands here. We resolve the
// route from the URL and mount the right view — keeping the static build and
// the client-side data-fetch pattern intact, while making deep links work.
import Base from "../layouts/Base.astro";
import ReportView from "../components/ReportView.astro";
---

<Base title="MarketMind AI" activeTab="analyze">
  <!-- report / share fallback -->
  <section class="screen" id="fb-report" style="display: none;">
    <div class="eyebrow" id="fb-report-eyebrow" style="display: none;">Shared report</div>
    <ReportView showActions={true} fromSlug={false} />
  </section>

  <!-- analyzing fallback -->
  <section class="screen" id="fb-analyzing" style="display: none;">
    <div class="eyebrow" data-i18n="an.eyebrow">Live analysis</div>
    <div class="anhead">
      <div class="pt product-thumb"></div>
      <div>
        <h2 class="product-title" id="fb-an-title" data-i18n="an.title">Analyzing your product…</h2>
        <div class="meta" id="fb-an-meta"></div>
      </div>
    </div>
    <div class="barwrap"><div class="b" id="fb-anbar"></div></div>
    <p class="mono faint" id="fb-an-hint" style="margin-top: 18px; font-size: 0.82rem;">Resolving analysis…</p>
  </section>

  <!-- genuine 404 -->
  <section class="screen" id="fb-404" style="display: none;">
    <div class="eyebrow">404</div>
    <h1>This page <em>drifted off</em>.</h1>
    <p class="sub">We couldn't find what you were looking for.</p>
    <p style="margin-top: 24px;"><a class="btn" href="/">Start an analysis <span class="ar">→</span></a></p>
  </section>
</Base>

<style>
  .anhead {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 6px;
  }
  .anhead .pt {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: linear-gradient(135deg, #2f4636, #7da06d);
    flex: none;
  }
  .anhead h2 {
    font-family: var(--font-display);
    font-weight: 450;
    font-size: 26px;
  }
  .anhead .meta {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
  }
  .barwrap {
    height: 3px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    overflow: hidden;
    margin: 26px 0 30px;
  }
  .barwrap .b {
    height: 100%;
    width: 30%;
    background: linear-gradient(90deg, var(--gold), var(--mint));
    animation: indet 1.4s var(--ease) infinite;
  }
  @keyframes indet {
    0% {
      margin-left: -30%;
    }
    100% {
      margin-left: 100%;
    }
  }
</style>

<script>
  import { getAnalysis } from "../lib/api";

  function init() {
    const parts = location.pathname.split("/").filter(Boolean);
    const kind = parts[0];
    const seg = parts[1];

    const report = document.getElementById("fb-report")!;
    const analyzing = document.getElementById("fb-analyzing")!;
    const notFound = document.getElementById("fb-404")!;

    // /report/<id> and /r/<slug> both mount the ReportView. The component reads
    // the id (and slug-vs-id) from the URL path itself, so we only reveal it.
    if ((kind === "report" || kind === "r") && seg && seg !== "_") {
      if (kind === "r") document.getElementById("fb-report-eyebrow")!.style.display = "flex";
      report.style.display = "block";
      return;
    }

    if (kind === "analyzing" && seg && seg !== "_") {
      analyzing.style.display = "block";
      const id = seg;
      const meta = document.getElementById("fb-an-meta")!;
      meta.textContent = `analysis ${id.slice(0, 8)}`;
      try {
        const title = sessionStorage.getItem(`mm:title:${id}`);
        if (title) document.getElementById("fb-an-title")!.textContent = title;
      } catch {
        /* ignore */
      }
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const minDelay = reduce ? 0 : 1400;
      const started = Date.now();
      getAnalysis(id)
        .then((a) => {
          const wait = Math.max(0, minDelay - (Date.now() - started));
          setTimeout(() => {
            if (a.status.toLowerCase() === "failed") {
              document.getElementById("fb-an-hint")!.textContent = a.failure_reason ?? "Analysis failed.";
            } else if (a.category) {
              meta.textContent = `${a.category} · analysis ${id.slice(0, 8)}`;
              window.location.assign(`/report/${id}`);
            } else {
              window.location.assign(`/report/${id}`);
            }
          }, wait);
        })
        .catch(() => {
          document.getElementById("fb-an-hint")!.textContent = "Could not reach the analysis service.";
        });
      return;
    }

    notFound.style.display = "block";
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
