---
import Base from "../../layouts/Base.astro";
import ReportView from "../../components/ReportView.astro";

// Public, read-only share view. The slug is the analysis UUID hex (dashes
// stripped); ReportView reconstructs the uuid and fetches it client-side.
export function getStaticPaths() {
  return [{ params: { slug: "_" } }];
}
---

<Base title="MarketMind AI — Shared report" activeTab="analyze">
  <section class="screen">
    <div class="eyebrow">Shared report</div>
    <ReportView showActions={false} fromSlug={true} />

    <div
      class="card"
      style="padding: 18px 22px; margin-top: 32px; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;"
    >
      <span class="muted" style="font-size: 0.9rem;">Want to score your own product?</span>
      <a class="btn" href="/">Start an analysis <span class="ar">→</span></a>
    </div>
  </section>
</Base>
