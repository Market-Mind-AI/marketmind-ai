---
import Base from "../../layouts/Base.astro";

// Static output: the id is read client-side. Provide a fallback param so the
// page builds, and let the runtime resolve real ids from the URL.
export function getStaticPaths() {
  return [{ params: { id: "_" } }];
}

const { id } = Astro.params;
---

<Base title="MarketMind AI — Analyzing" activeTab="analyze">
  <section class="screen" id="screen-analyzing">
    <div class="eyebrow" data-i18n="an.eyebrow">Live analysis</div>
    <div class="anhead">
      <div class="pt product-thumb" id="an-thumb"></div>
      <div>
        <h2 class="product-title" id="an-title" data-i18n="an.title">Analyzing your product…</h2>
        <div class="meta" id="an-meta">analysis · <span id="an-id">{id}</span></div>
      </div>
    </div>

    <div class="barwrap"><div class="b" id="anbar"></div></div>

    <div class="steps" id="steps">
      <div class="st" data-res-key="res.attrs"><div class="dotc">✓</div><div class="sl" data-i18n="an.step1">Reading product images (vision)</div><div class="res"></div></div>
      <div class="st" data-res-key="res.classified"><div class="dotc">✓</div><div class="sl" data-i18n="an.step2">Classifying product &amp; attributes</div><div class="res"></div></div>
      <div class="st" data-res-key="res.trend"><div class="dotc">✓</div><div class="sl" data-i18n="an.step3">Google Trends — demand trajectory</div><div class="res"></div></div>
      <div class="st" data-res-key="res.markets"><div class="dotc">✓</div><div class="sl" data-i18n="an.step4">World Bank + IMF — growth &amp; geography</div><div class="res"></div></div>
      <div class="st" data-res-key="res.live"><div class="dotc">✓</div><div class="sl" data-i18n="an.step5">eBay marketplace — live demand signal</div><div class="res"></div></div>
      <div class="st" data-res-key="res.scored"><div class="dotc">✓</div><div class="sl" data-i18n="an.step6">Scoring Market Opportunity (MOS)</div><div class="res"></div></div>
      <div class="st" data-res-key="res.ready"><div class="dotc">✓</div><div class="sl" data-i18n="an.step7">Writing explainable report</div><div class="res"></div></div>
    </div>

    <div id="an-error" class="an-error" style="display: none;"></div>
  </section>
</Base>

<style is:global>
  .anhead {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 6px;
  }
  .anhead .pt {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: linear-gradient(135deg, #2f4636, #7da06d);
    flex: none;
  }
  .anhead h2 {
    font-family: var(--font-display);
    font-weight: 450;
    font-size: 26px;
    line-height: 1.1;
  }
  .anhead .meta {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted);
  }
  .barwrap {
    height: 3px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    overflow: hidden;
    margin: 26px 0 30px;
  }
  .barwrap .b {
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--gold), var(--mint));
    transition: width 0.7s var(--ease);
  }
  .steps {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .st {
    display: grid;
    grid-template-columns: 30px 1fr auto;
    gap: 14px;
    align-items: center;
    padding: 15px 6px;
    border-bottom: 1px solid var(--line-2);
    opacity: 0.32;
    transition: opacity 0.5s;
  }
  .st.run,
  .st.done {
    opacity: 1;
  }
  .st .dotc {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1.5px solid var(--faint);
    display: grid;
    place-items: center;
    font-size: 12px;
    transition: 0.4s;
    color: transparent;
  }
  .st.run .dotc {
    border-color: var(--gold);
    animation: spin 1s linear infinite;
    border-right-color: transparent;
  }
  .st.done .dotc {
    border-color: var(--mint);
    background: var(--mint);
    color: #10130f;
    animation: none;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .st .sl {
    font-size: 15px;
    color: var(--ink-soft);
    font-weight: 500;
  }
  .st.done .sl {
    color: var(--ink);
  }
  .st .res {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--mint);
    opacity: 0;
    transform: translateX(8px);
    transition: 0.5s;
  }
  .st.done .res {
    opacity: 1;
    transform: none;
  }
  .an-error {
    margin-top: 26px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--coral);
    border: 1px solid rgba(233, 106, 76, 0.35);
    background: rgba(233, 106, 76, 0.08);
    border-radius: 12px;
    padding: 14px 18px;
  }
</style>

<script>
  import { getAnalysis } from "../../lib/api";
  import { t } from "../../lib/i18n";

  function init() {
    const root = document.getElementById("screen-analyzing");
    if (!root || root.dataset.bound === "1") return;
    root.dataset.bound = "1";

    // Derive the id from the URL path (robust for static + dynamic builds).
    const id = location.pathname.split("/").filter(Boolean).pop();
    if (!id || id === "_") return;

    const idEl = document.getElementById("an-id");
    if (idEl) idEl.textContent = id.slice(0, 8);

    // Pull the title we stashed when submitting (image_refs aren't URLs).
    let title = "";
    try {
      title = sessionStorage.getItem(`mm:title:${id}`) ?? "";
    } catch {
      /* ignore */
    }
    if (title) {
      const titleEl = document.getElementById("an-title");
      if (titleEl) titleEl.textContent = title;
    }

    const bar = document.getElementById("anbar") as HTMLDivElement;
    const errorEl = document.getElementById("an-error") as HTMLDivElement;
    const steps = Array.from(document.querySelectorAll<HTMLDivElement>("#steps .st"));
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let confirmed: "ok" | "fail" | null = null;
    let failReason = "";
    let navigated = false;

    function goReport() {
      if (navigated) return;
      navigated = true;
      window.location.assign(`/report/${id}`);
    }

    function fail(reason: string) {
      errorEl.style.display = "block";
      errorEl.textContent = reason || "Analysis failed.";
    }

    // Concurrently confirm the analysis really completed (fake mode finishes
    // synchronously inside the POST, so this resolves almost immediately).
    getAnalysis(id!)
      .then((a) => {
        const s = a.status.toLowerCase();
        if (s === "failed") {
          confirmed = "fail";
          failReason = a.failure_reason ?? "Analysis failed.";
        } else {
          confirmed = "ok";
        }
        // Prefer the real category for the header once we have it.
        if (a.category) {
          const meta = document.getElementById("an-meta");
          if (meta) meta.textContent = `${a.category} · analysis ${id!.slice(0, 8)}`;
        }
      })
      .catch(() => {
        // Network error confirming — let the scripted run finish and try to
        // navigate anyway; the report page surfaces any real error.
        confirmed = "ok";
      });

    if (reduce) {
      // No animation: light everything, then resolve to the report.
      steps.forEach((s) => s.classList.add("done", "run"));
      bar.style.width = "100%";
      const wait = setInterval(() => {
        if (confirmed === "fail") {
          clearInterval(wait);
          fail(failReason);
        } else if (confirmed === "ok") {
          clearInterval(wait);
          goReport();
        }
      }, 120);
      return;
    }

    // Scripted, timed step reveal (~4.5–5.5s total).
    let i = 0;
    const tick = () => {
      if (i > 0) {
        const prev = steps[i - 1];
        prev.classList.remove("run");
        prev.classList.add("done");
        const res = prev.querySelector<HTMLDivElement>(".res");
        if (res) res.textContent = prev.dataset.resKey ? t(prev.dataset.resKey) : "";
      }
      bar.style.width = `${Math.round((i / steps.length) * 100)}%`;

      if (i < steps.length) {
        steps[i].classList.add("run");
        i++;
        setTimeout(tick, 600 + Math.random() * 380);
      } else {
        bar.style.width = "100%";
        // All steps revealed — resolve against the confirmed GET result.
        const settle = () => {
          if (confirmed === "fail") {
            fail(failReason);
          } else if (confirmed === "ok") {
            setTimeout(goReport, 420);
          } else {
            // Still waiting on the GET; poll briefly.
            setTimeout(settle, 150);
          }
        };
        settle();
      }
    };
    setTimeout(tick, 360);
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
