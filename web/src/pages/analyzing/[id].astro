---
import Base from "../../layouts/Base.astro";

// Static output: the id is read client-side. Provide a fallback param so the
// page builds, and let the dev/runtime resolve real ids from the URL.
export function getStaticPaths() {
  // Placeholder path so the static build succeeds; the real id is read from the
  // URL client-side. In `astro dev`, arbitrary ids resolve on demand.
  return [{ params: { id: "_" } }];
}

const { id } = Astro.params;
---

<Base title="MarketMind AI — Analyzing">
  <section class="wrap" style="max-width: 720px; padding: 24px 24px 64px;">
    <p class="eyebrow">Pipeline running</p>
    <h1 style="font-size: clamp(1.8rem, 4vw, 2.6rem);">Analyzing your product…</h1>
    <p class="muted mono" style="font-size: 0.82rem;">analysis <span id="analysis-id">{id}</span></p>

    <ol id="steps" class="steps card" style="padding: 8px; margin-top: 26px; list-style: none;">
      <li data-step="extracting"><span class="dot"></span> Extracting attributes</li>
      <li data-step="enriching"><span class="dot"></span> Enriching with market signals</li>
      <li data-step="scoring"><span class="dot"></span> Computing opportunity score</li>
      <li data-step="embedding"><span class="dot"></span> Embedding &amp; finding comparables</li>
      <li data-step="reporting"><span class="dot"></span> Generating report</li>
    </ol>

    <div id="live" class="mono faint" style="margin-top: 18px; font-size: 0.82rem; min-height: 1.4em;"></div>
    <div id="error" class="tier-pill tier-weak" style="display: none; margin-top: 18px;"></div>
  </section>
</Base>

<style>
  .steps li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 9px;
    color: var(--ink-faint);
    transition: color 0.2s ease, background 0.2s ease;
  }
  .steps li + li {
    border-top: 1px solid var(--line-soft);
  }
  .steps li .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line);
    flex: none;
    transition: background 0.2s ease, box-shadow 0.2s ease;
  }
  .steps li.active {
    color: var(--ink);
    background: var(--gold-soft);
  }
  .steps li.active .dot {
    background: var(--gold);
    box-shadow: 0 0 0 4px var(--gold-soft);
    animation: pulse 1.1s ease-in-out infinite;
  }
  .steps li.done {
    color: var(--ink-dim);
  }
  .steps li.done .dot {
    background: var(--mint);
  }
  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 8px transparent;
    }
  }
</style>

<script>
  import { subscribeProgress, getAnalysis, isTerminalStatus } from "../../lib/api";

  const ORDER = ["extracting", "enriching", "scoring", "embedding", "reporting"];

  function init() {
    const idEl = document.getElementById("analysis-id");
    if (!idEl) return;
    // Derive the id from the URL path (robust for static + dynamic builds).
    const id = location.pathname.split("/").filter(Boolean).pop();
    if (!id || id === "_") return;
    idEl.textContent = id;

    const live = document.getElementById("live")!;
    const errorEl = document.getElementById("error")!;
    const steps = Array.from(document.querySelectorAll<HTMLLIElement>("#steps li"));

    function markStep(step: string) {
      const idx = ORDER.indexOf(step);
      steps.forEach((li) => {
        const liStep = ORDER.indexOf(li.dataset.step ?? "");
        li.classList.toggle("done", idx >= 0 && liStep < idx);
        li.classList.toggle("active", liStep === idx);
      });
    }

    function goReport() {
      window.location.assign(`/report/${id}`);
    }

    function fail(detail: string) {
      errorEl.style.display = "inline-block";
      errorEl.textContent = detail || "analysis failed";
    }

    const dispose = subscribeProgress(id, {
      onEvent: (ev) => {
        if (ev.detail) live.textContent = `→ ${ev.detail}`;
        if (ev.step === "completed") {
          steps.forEach((li) => li.classList.add("done"));
          dispose();
          goReport();
          return;
        }
        if (ev.step === "failed") {
          dispose();
          fail(ev.detail);
          return;
        }
        markStep(ev.step);
      },
      onError: async () => {
        // SSE dropped — poll once to recover terminal state.
        try {
          const a = await getAnalysis(id);
          if (isTerminalStatus(a.status)) {
            dispose();
            if (a.report || a.status.toLowerCase() === "completed") goReport();
            else fail(a.failure_reason ?? "analysis failed");
          }
        } catch {
          /* keep the stream open; transient */
        }
      },
    });

    // Safety net: if already done before the stream attaches.
    getAnalysis(id)
      .then((a) => {
        if (a.status.toLowerCase() === "completed") {
          dispose();
          goReport();
        } else if (a.status.toLowerCase() === "failed") {
          dispose();
          fail(a.failure_reason ?? "analysis failed");
        }
      })
      .catch(() => {});
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
