# Base URL of the MarketMind API, exposed to the browser via Astro's PUBLIC_
# convention and inlined into the bundle at BUILD time.
#
# In dev this is the orchestrator (marketmind-orchestrator, host port 8081).
# Pointing it at the scoring service instead (http://localhost:8004) also works —
# it exposes the same /analyze, /catalog and /countries routes — but bypasses
# the agent. The deployed image bakes PUBLIC_API_BASE=/api (see Dockerfile).
PUBLIC_API_BASE=http://localhost:8081
