# Base URL of the MarketMind API, exposed to the browser via Astro's PUBLIC_
# convention and inlined into the bundle at BUILD time.
#
# "/api" in every setup: in dev the Astro server forwards /api to the
# orchestrator (API_PROXY_TARGET, default http://localhost:8081, see
# astro.config.mjs); in the deployed image nginx does the same.
PUBLIC_API_BASE=/api
