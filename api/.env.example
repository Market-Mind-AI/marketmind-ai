# =============================================================================
# MarketMind AI — example environment configuration
# Copy to `.env` (api/.env) and adjust. Defaults below run the app FULLY OFFLINE
# with no external services or API keys (provider_mode=fake).
# All variables are prefixed MARKETMIND_.
# =============================================================================

# --- Provider selection -------------------------------------------------------
# "fake" = all in-memory/offline adapters (default). "real" = use real adapters
# where credentials are present (falls back / stubs otherwise).
MARKETMIND_PROVIDER_MODE=fake

# --- Persistence --------------------------------------------------------------
# When use_in_memory_persistence is true the SQLAlchemy/pgvector adapters are
# bypassed entirely, so the database URL is unused in the default offline setup.
MARKETMIND_USE_IN_MEMORY_PERSISTENCE=true
MARKETMIND_DATABASE_URL=postgresql+asyncpg://marketmind:marketmind@localhost:5432/marketmind

# --- LLM / vendor API keys (only needed when provider_mode=real) --------------
MARKETMIND_ANTHROPIC_API_KEY=
MARKETMIND_COHERE_API_KEY=

# --- Model identifiers --------------------------------------------------------
MARKETMIND_EXTRACTION_MODEL=claude-haiku-4-5-20251001
MARKETMIND_REPORT_MODEL=claude-sonnet-4-6
MARKETMIND_EMBEDDING_MODEL=embed-english-v3.0
MARKETMIND_EMBEDDING_DIMENSIONS=1024

# --- Object storage -----------------------------------------------------------
MARKETMIND_STORAGE_ROOT=./.data/uploads
MARKETMIND_STORAGE_BASE_URL=

# --- External market-signal connectors (only needed when provider_mode=real) --
MARKETMIND_DATAFORSEO_LOGIN=
MARKETMIND_DATAFORSEO_PASSWORD=
MARKETMIND_EBAY_APP_ID=

# --- HTTP / server ------------------------------------------------------------
# CORS origins is a JSON-style list; ["*"] allows any origin.
MARKETMIND_CORS_ORIGINS=["*"]
MARKETMIND_HOST=0.0.0.0
MARKETMIND_PORT=8000
MARKETMIND_LOG_LEVEL=INFO
